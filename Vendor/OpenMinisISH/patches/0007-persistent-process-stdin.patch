+                ssize_t written = write(fd, bytes, remaining);
+                if (written > 0) {
+                    bytes += written;
+                    remaining -= (size_t)written;
+                    continue;
+                }
+                if (written < 0 && errno == EINTR) continue;
+                if (written < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) {
+                    struct pollfd pfd = {.fd = fd, .events = POLLOUT};

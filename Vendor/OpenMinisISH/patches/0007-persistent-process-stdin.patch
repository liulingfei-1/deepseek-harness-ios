+                    if (self->_stdinWriteFd == fd) {
+                        fdToClose = fd;
+                        self->_stdinWriteFd = -1;
+                        self->_acceptsStdin = NO;
+                    }
+                }
+                if (fdToClose >= 0) close(fdToClose);
+                break;
+            }
+            @synchronized(self) {
+                if (self->_pendingStdinBytes >= payload.length) {
+                    self->_pendingStdinBytes -= payload.length;
+                } else {
+                    self->_pendingStdinBytes = 0;
+                }
+            }
+        });
+    }
+    return YES;
+}

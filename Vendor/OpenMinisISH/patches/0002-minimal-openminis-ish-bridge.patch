+static const NSUInteger ISHMaxCapturedOutputCharacters = 1024 * 1024;
+static NSString *const ISHOutputTruncationMarker = @"\n[output truncated]\n";
+
++ (void)appendCapturedString:(NSString *)string toBuffer:(NSMutableString *)buffer {
+    @synchronized(buffer) {
+        if ([buffer hasSuffix:ISHOutputTruncationMarker]) return;
+        NSUInteger contentLimit = ISHMaxCapturedOutputCharacters - ISHOutputTruncationMarker.length;
+        if (buffer.length >= contentLimit) {
+            [buffer appendString:ISHOutputTruncationMarker];
+            return;
+        }
+        NSUInteger remaining = contentLimit - buffer.length;
+        if (string.length <= remaining) {
+            [buffer appendString:string];
+            return;
+        }
+        [buffer appendString:[string substringToIndex:remaining]];
+        [buffer appendString:ISHOutputTruncationMarker];
+    }
+}
 
